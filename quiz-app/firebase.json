{
  "hosting": [
    {
      "site": "united89-club",
      "public": "public",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "headers": [
        {
          "source": "/yaadein/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=31536000, s-maxage=31536000, immutable"
            }
          ]
        }
      ],
      "rewrites": [
        {
          "source": "**",
          "run": {
            "serviceId": "united89-quiz-frontend",
            "region": "asia-south2"
          }
        }
      ]
    },
    {
      "site": "uce-quiz",
      "public": "public",
      "ignore": [
