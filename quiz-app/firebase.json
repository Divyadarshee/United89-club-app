{
  "hosting": [
    {
      "site": "united89-club",
      "public": "public",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "rewrites": [
        {
          "source": "**",
          "run": {
            "serviceId": "united89-quiz-frontend",
            "region": "asia-south2"
          }
        }
      ]
    },
    {
      "site": "uce-quiz",
      "public": "public",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "rewrites": [
        {
          "source": "**",
          "run": {
            "serviceId": "uce-quiz-frontend",
            "region": "asia-south2"
          }
        }
      ]
    }
  ]
}